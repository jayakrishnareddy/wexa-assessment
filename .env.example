# CognoDB Cloud connection details.
# Copy to `.env.local` and fill in the values from https://console.cognodb.com
# `.env.local` is gitignored — never commit real credentials.

# Bolt URI for your instance, e.g. bolt+s://<instance-id>.databases.cognodb.com
COGNODB_URI=

# CognoDB provisions every instance with this user.
COGNODB_USER=cognodb

# Generated at instance creation and shown exactly once.
COGNODB_PASSWORD=

# Target database. Leave as the default unless you created another one.
COGNODB_DATABASE=neo4j
